{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/chat",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fraudshieldsmb.com"
        }
      ],
      "destination": "https://www.fraudshieldsmb.com/:path*",
      "permanent": true
    }
  ]
}
